# XDG MIME defaults for the user.
#
# Rules of thumb:
#   * Use canonical .desktop names from /usr/share/applications only.
#   * Never reference removed/uninstalled apps (xpdf was a ghost).
#   * Never reference wine-extension-* / wine-protocol-* — those are auto-
#     generated by `wine` on installer runs and pollute the launcher.
#   * `[Default Applications]` = single primary handler.
#   * `[Added Associations]`   = list of acceptable handlers (right-click ▸ Open With).
#   * `[Removed Associations]` = blacklist; we use it to suppress wine handlers
#     that may reappear if you ever run a Windows installer again.

[Default Applications]
# --- web / pdf / html ---
text/html=firefox.desktop
application/xhtml+xml=firefox.desktop
application/x-extension-htm=firefox.desktop
application/x-extension-html=firefox.desktop
application/x-extension-shtml=firefox.desktop
application/x-extension-xhtml=firefox.desktop
application/x-extension-xht=firefox.desktop
application/pdf=firefox.desktop

# --- URL schemes ---
x-scheme-handler/http=firefox.desktop
x-scheme-handler/https=firefox.desktop
x-scheme-handler/ftp=firefox.desktop
x-scheme-handler/about=firefox.desktop
x-scheme-handler/unknown=firefox.desktop
x-scheme-handler/chrome=chromium.desktop
x-scheme-handler/tg=org.telegram.desktop.desktop
x-scheme-handler/tonsite=org.telegram.desktop.desktop
x-scheme-handler/mailto=org.mozilla.Thunderbird.desktop
x-scheme-handler/webcal=org.mozilla.Thunderbird.desktop
x-scheme-handler/webcals=org.mozilla.Thunderbird.desktop
x-scheme-handler/jetbrains=jetbrainsd.desktop
x-scheme-handler/fleet=jetbrains-fleet.desktop

# --- email / calendar ---
message/rfc822=org.mozilla.Thunderbird.desktop
text/calendar=org.mozilla.Thunderbird.desktop
application/x-extension-ics=org.mozilla.Thunderbird.desktop

# --- images (feh — light & keyboard-driven) ---
image/jpeg=feh.desktop
image/png=feh.desktop
image/gif=feh.desktop
image/webp=feh.desktop
image/bmp=feh.desktop
image/tiff=feh.desktop
image/svg+xml=firefox.desktop

# --- audio / video (mpv — lightest, best key bindings) ---
video/mp4=mpv.desktop
video/x-matroska=mpv.desktop
video/webm=mpv.desktop
video/quicktime=mpv.desktop
video/x-msvideo=mpv.desktop
audio/mpeg=mpv.desktop
audio/flac=mpv.desktop
audio/ogg=mpv.desktop
audio/x-wav=mpv.desktop

# --- text / source code ---
text/plain=gvim.desktop
text/markdown=gvim.desktop
application/json=gvim.desktop
application/sql=gvim.desktop
application/x-shellscript=gvim.desktop
application/x-yaml=gvim.desktop

# --- file manager ---
inode/directory=pcmanfm.desktop

[Added Associations]
text/html=firefox.desktop;chromium.desktop;
application/pdf=firefox.desktop;chromium.desktop;
x-scheme-handler/http=firefox.desktop;chromium.desktop;
x-scheme-handler/https=firefox.desktop;chromium.desktop;
x-scheme-handler/tg=org.telegram.desktop.desktop;
x-scheme-handler/tonsite=org.telegram.desktop.desktop;
x-scheme-handler/mailto=org.mozilla.Thunderbird.desktop;
text/calendar=org.mozilla.Thunderbird.desktop;
image/jpeg=feh.desktop;firefox.desktop;
image/png=feh.desktop;firefox.desktop;
image/gif=feh.desktop;firefox.desktop;
video/mp4=mpv.desktop;vlc.desktop;
video/x-matroska=mpv.desktop;vlc.desktop;
audio/mpeg=mpv.desktop;vlc.desktop;
text/plain=gvim.desktop;
application/sql=gvim.desktop;

[Removed Associations]
# Suppress every wine-* handler that might re-register itself. Listed by
# extension family; harmless if the wine .desktop is absent.
text/plain=wine-extension-txt.desktop;
text/html=wine-extension-htm.desktop;wine-extension-html.desktop;
application/pdf=wine-extension-pdf.desktop;
image/jpeg=wine-extension-jpe.desktop;wine-extension-jfif.desktop;
image/png=wine-extension-png.desktop;
image/gif=wine-extension-gif.desktop;
application/xml=wine-extension-xml.desktop;
text/xml=wine-extension-xml.desktop;
x-scheme-handler/battlenet=wine-protocol-battlenet.desktop;wine-protocol-Blizzard.URI.Battlenet.desktop;
x-scheme-handler/blizzard=wine-protocol-blizzard.desktop;wine-protocol-Blizzard.URI.Blizzard.desktop;
x-scheme-handler/heroes=wine-protocol-heroes.desktop;wine-protocol-Blizzard.URI.Heroes.desktop;
x-scheme-handler/starcraft=wine-protocol-starcraft.desktop;wine-protocol-Blizzard.URI.SC2.desktop;
