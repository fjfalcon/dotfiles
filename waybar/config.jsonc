// -*- mode: jsonc -*-
// Waybar — Sway, Solarized Dark, JetBrainsMono Nerd Font.
//
// Why an array of bars instead of one shared config?
//   waybar 0.15 silently ignores the module-level "output" filter for custom
//   modules, so we cannot make a single bar render a different `custom/swaync_*`
//   per monitor.  Defining one bar per output (with bar-level "output" filter)
//   is the canonical fix.  Common module definitions live in modules.jsonc and
//   are pulled in via "include".
[
  {
    "name": "primary-dp1",
    "output": "DP-1",
    "include": ["~/.config/waybar/modules.jsonc"],

    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,

    "modules-left":   ["sway/workspaces", "sway/mode", "sway/scratchpad"],
    "modules-center": ["sway/window"],
    "modules-right":  [
      "custom/vpn", "network", "bluetooth", "pulseaudio", "memory", "cpu", "temperature",
      "sway/language", "clock", "custom/swaync_dp1", "tray"
    ]
  },

  {
    "name": "secondary-dp2",
    "output": "DP-2",
    "include": ["~/.config/waybar/modules.jsonc"],

    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,

    "modules-left":   ["sway/workspaces", "sway/mode", "sway/scratchpad"],
    "modules-center": ["sway/window"],
    "modules-right":  [
      "custom/vpn", "network", "bluetooth", "pulseaudio", "memory", "cpu", "temperature",
      "sway/language", "clock", "custom/swaync_dp2", "tray"
    ]
  }
]
